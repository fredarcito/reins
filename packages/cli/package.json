{
  "name": "reins",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "src",
    "templates",
    "LICENSE"
  ],
  "description": "Command line for reins: init, check, doctor, sync and friends.",
  "type": "module",
  "bin": {
    "reins": "./src/bin.js"
  },
  "exports": {
    ".": "./src/main.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@reins/core": "workspace:^",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE');require('fs').cpSync('../../templates','templates',{recursive:true})\"",
    "postpack": "node -e \"require('fs').rmSync('templates',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@reins/adapter-js": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredarcito/harness.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/fredarcito/harness#readme",
  "bugs": {
    "url": "https://github.com/fredarcito/harness/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
