{
  "name": "@harness/cli",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "src",
    "templates",
    "LICENSE"
  ],
  "description": "Command line for the harness: init, check, doctor, sync and friends.",
  "type": "module",
  "bin": {
    "harness": "./src/bin.js"
  },
  "exports": {
    ".": "./src/main.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@harness/core": "workspace:^",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "prepack": "node -e \"require('fs').cpSync('../../templates','templates',{recursive:true})\"",
    "postpack": "node -e \"require('fs').rmSync('templates',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@harness/adapter-js": "workspace:^"
  }
}
