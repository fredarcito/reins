{
  "name": "@agentreins/cli",
  "version": "0.17.0",
  "license": "MIT",
  "files": [
    "src",
    "templates",
    "LICENSE"
  ],
  "description": "An engineering harness for AI coding agents: persistent project knowledge, enforceable architecture and consistent workflows across models, agents and sessions.",
  "type": "module",
  "bin": {
    "reins": "./src/bin.js"
  },
  "exports": {
    ".": "./src/main.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentreins/core": "workspace:^",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE');require('fs').cpSync('../../templates','templates',{recursive:true})\"",
    "postpack": "node -e \"require('fs').rmSync('templates',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@agentreins/adapter-js": "workspace:^",
    "@agentreins/adapter-rails": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredarcito/reins.git",
    "directory": "packages/cli"
  },
  "homepage": "https://fredarcito.github.io/reins/",
  "bugs": {
    "url": "https://github.com/fredarcito/reins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "reins",
    "ai",
    "coding-agents",
    "claude-code",
    "architecture",
    "lint",
    "dependencies",
    "monorepo",
    "cli"
  ]
}
