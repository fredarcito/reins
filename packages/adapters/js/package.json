  },
  "devDependencies": {
    "@harness/core": "workspace:^",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "dependency-cruiser": "^18.7.2",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
