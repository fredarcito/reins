{
  "name": "@harness/adapter-js",
  "version": "0.0.0",
  "description": "Harness language adapter for JavaScript/TypeScript projects (Vite + React, Next).",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "presets",
    "rules"
